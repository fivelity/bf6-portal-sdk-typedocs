{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "sdk/index.ts",
    "sdk/mod.d.ts",
    "sdk/docs-entry.ts",
    "node_modules/bf6-portal-utils/*/index.ts"
  ]
}
